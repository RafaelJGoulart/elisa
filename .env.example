# Elisa — variáveis de ambiente (copie para .env se necessário)

# Caminho do banco SQLite. Padrão: data/elisa.db na raiz do projeto.
# DATABASE_URL=sqlite:///C:/caminho/para/elisa.db

# Servidor Flask (mantenha 127.0.0.1 para uso estritamente local)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Serve o build do frontend pelo Flask quando frontend/dist existir.
SERVE_FRONTEND=true
